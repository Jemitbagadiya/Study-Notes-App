<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.StudyNotes" parent="Theme.Material3.Light.NoActionBar">

        <item name="colorPrimary">#7C4DFF</item>
        <item name="colorPrimaryVariant">#5E35B1</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <item name="android:statusBarColor">#FFFFFF</item>

        <!-- Status bar icons black -->
        <item name="android:windowLightStatusBar">true</item>

    </style>

    <!-- Toolbar Bold Title -->
    <style name="ToolbarTitleBold">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
    </style>

    <!-- Popup Menu Style -->
    <style name="PopupMenuStyle"
        parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">
            @android:color/white
        </item>
    </style>

</resources>